{
  "_version": "1.49.0",
  "sap.app": {
      "id": "sap.defectmgmt",
      "type": "application",
      "i18n": "i18n/i18n.properties",
      "applicationVersion": {
        "version": "1.0.0"
      },
      "dataSources": {
        "issueService": {
          "uri": "/sap/opu/odata4/sap/zui_issue_srvbind/srvd/sap/zui_issue_srvdef/0001/",
          "type": "OData",
          "settings": {
            "odataVersion": "4.0"
          }
        }
      }
    },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.f": {},
        "sap.ui.layout": {},
        "sap.ui.unified": {},
        "sap.suite.ui.microchart": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "userModel": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "defectModel": {
        "dataSource": "issueService",
        "type": "sap.ui.model.odata.v2.ODataModel",
        "settings": {
          "defaultBindingMode": "TwoWay",
          "useBatch": false
        }
      },
      "kpiModel": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "localService/mockdata/dashboard.json"
      }
    
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "sap.defectmgmt.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "name": "Login",
          "pattern": "",
          "target": ["TargetLogin"]
        },
        {
          "name": "Dashboard",
          "pattern": "dashboard",
          "target": ["TargetDashboard"]
        },
        {
          "name": "IssueDetail",
          "pattern": "issue/{issuePath}",
          "target": ["TargetIssueDetail"]
        }
      ],
      "targets": {
        "TargetLogin": {
          "viewType": "XML",
          "transition": "fade",
          "viewId": "Login",
          "viewName": "Login"
        },
        "TargetDashboard": {
          "viewType": "XML",
          "transition": "slide",
          "viewId": "Dashboard",
          "viewName": "Dashboard"
        },
        "TargetIssueDetail": {
          "viewType": "XML",
          "transition": "slide",
          "viewId": "IssueDetail",
          "viewName": "IssueDetail"
        }
      }
    },
    "rootView": {
      "viewName": "sap.defectmgmt.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    }
  }
}