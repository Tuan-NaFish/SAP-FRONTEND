{
  "_version": "1.49.0",

  "sap.app": {
    "id": "sap.defectmgmt",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "SAP Defect Management System",
    "description": "Defect tracking and lifecycle management for SAP ERP modules",

    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_issue_srvbind/srvd/sap/zui_issue_srvdef/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/metadata.xml"
        }
      }
    }
  },

  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://quality-issue"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },

  "sap.ui5": {
    "flexEnabled": false,

    "rootView": {
      "viewName": "sap.defectmgmt.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },

    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.uxap": {},
        "sap.f": {},
        "sap.ui.unified": {},
        "sap.suite.ui.microchart": {}
      }
    },

    "contentDensities": {
      "compact": true,
      "cozy": true
    },

    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleUrl": "i18n/i18n.properties",
          "supportedLocales": [""],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": false,
        "settings": {
          "autoExpandSelect": true,
          "operationMode": "Server",
          "synchronizationMode": "None",
          "groupId": "$direct",
          "updateGroupId": "$direct"
        }
      },
      "userModel": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "userRole": {
        "type": "sap.ui.model.json.JSONModel"
      }
    },

    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },

    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "sap.defectmgmt.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "async": true
      },
      "routes": [
        {
          "name": "Login",
          "pattern": "",
          "target": ["Login"]
        },
        {
          "name": "IssueList",
          "pattern": "issues",
          "target": ["IssueList"]
        },
        {
          "name": "IssueDetail",
          "pattern": "issue/{issueId}",
          "target": ["IssueDetail"]
        },
        {
          "name": "CreateIssue",
          "pattern": "create",
          "target": ["CreateIssue"]
        },
        {
          "name": "Dashboard",
          "pattern": "dashboard",
          "target": ["Dashboard"]
        },
        {
          "name": "DeveloperWorklist",
          "pattern": "developerWorklist",
          "target": ["DeveloperWorklist"]
        },
        {
          "name": "TesterWorklist",
          "pattern": "testerWorklist",
          "target": ["TesterWorklist"]
        }
      ],
      "targets": {
        "Login": {
          "viewType": "XML",
          "viewName": "Login",
          "viewLevel": 0
        },
        "IssueList": {
          "viewType": "XML",
          "viewName": "IssueList",
          "viewLevel": 1
        },
        "IssueDetail": {
          "viewType": "XML",
          "viewName": "IssueDetail",
          "viewLevel": 2
        },
        "CreateIssue": {
          "viewType": "XML",
          "viewName": "CreateIssue",
          "viewLevel": 2
        },
        "Dashboard": {
          "viewType": "XML",
          "viewName": "Dashboard",
          "viewLevel": 2
        },
        "DeveloperWorklist": {
          "viewType": "XML",
          "viewName": "DeveloperWorklist",
          "viewLevel": 1
        },
        "TesterWorklist": {
          "viewType": "XML",
          "viewName": "TesterWorklist",
          "viewLevel": 1
        }
      }
    }
  }
}
