<mvc:View
    controllerName="sap.defectmgmt.controller.IssueDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true">
    
    <Page id="detailPage">
        <customHeader>
            <f:ShellBar 
                title="SAP Defect Management System" 
                homeIcon="https://ui5.sap.com/resources/sap/ui/documentation/sdk/images/logo_sap.png"
                showNavButton="true"
                navButtonPressed=".onNavBack" />
        </customHeader>

        <content>
            <uxap:ObjectPageLayout id="ObjectPageLayout" showTitleInHeaderContent="true" alwaysShowContentHeader="false" preserveHeaderStateOnScroll="false" headerContentPinnable="true" isChildPage="true">
                
                <uxap:headerTitle>
                    <uxap:ObjectPageDynamicHeaderTitle>
                        <uxap:expandedHeading>
                            <Title text="{defectModel>ISSUE_ID} - {defectModel>TITLE}" wrapping="true" class="sapUiSmallMarginEnd"/>
                        </uxap:expandedHeading>
                        <uxap:snappedHeading>
                            <Title text="{defectModel>ISSUE_ID}" wrapping="true"/>
                        </uxap:snappedHeading>
                        <uxap:actions>
                            <Button text="Start Progress" type="Emphasized" />
                            <Button text="Resolve" type="Success" />
                            <Button text="Edit" />
                        </uxap:actions>
                    </uxap:ObjectPageDynamicHeaderTitle>
                </uxap:headerTitle>

                <uxap:headerContent>
                    <FlexBox wrap="Wrap" fitContainer="true">
                        <layout:VerticalLayout class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                            <Label text="Status" />
                            <ObjectStatus text="{defectModel>STATUS}" state="{= ${defectModel>STATUS} === 'NEW' ? 'Information' : ${defectModel>STATUS} === 'IN_PROGRESS' ? 'Warning' : ${defectModel>STATUS} === 'RESOLVED' ? 'Success' : 'None' }" inverted="true" />
                        </layout:VerticalLayout>
                        <layout:VerticalLayout class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                            <Label text="Severity" />
                            <ObjectStatus text="{defectModel>SEVERITY}" state="{= ${defectModel>SEVERITY} === 'Critical' ? 'Error' : ${defectModel>SEVERITY} === 'High' ? 'Warning' : ${defectModel>SEVERITY} === 'Medium' ? 'Success' : 'None' }" inverted="true" />
                        </layout:VerticalLayout>
                        <layout:VerticalLayout class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                            <Label text="Assignee" />
                            <Text text="{defectModel>ASSIGNED_TO}" />
                        </layout:VerticalLayout>
                    </FlexBox>
                </uxap:headerContent>

                <uxap:sections>
                    <uxap:ObjectPageSection titleUppercase="false" title="Overview">
                        <uxap:subSections>
                            <uxap:ObjectPageSubSection title="General Information">
                                <uxap:blocks>
                                    <form:SimpleForm layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
                                        <form:content>
                                            <Label text="Module"/>
                                            <Text text="{defectModel>MODULE}"/>
                                            <Label text="Environment"/>
                                            <Text text="{defectModel>ENVIRONMENT}"/>
                                            <Label text="T-Code"/>
                                            <Text text="{defectModel>TCODE}"/>
                                            <Label text="Description"/>
                                            <Text text="{defectModel>DESCRIPTION}"/>
                                        </form:content>
                                    </form:SimpleForm>
                                </uxap:blocks>
                            </uxap:ObjectPageSubSection>
                        </uxap:subSections>
                    </uxap:ObjectPageSection>

                    <uxap:ObjectPageSection titleUppercase="false" title="Attachments">
                        <uxap:subSections>
                            <uxap:ObjectPageSubSection title="Uploaded Files">
                                <uxap:blocks>
                                    <Text text="(Member 2 will put UploadSet here)" class="sapUiSmallMargin"/>
                                </uxap:blocks>
                            </uxap:ObjectPageSubSection>
                        </uxap:subSections>
                    </uxap:ObjectPageSection>

                    <uxap:ObjectPageSection titleUppercase="false" title="History">
                        <uxap:subSections>
                            <uxap:ObjectPageSubSection title="Activity Timeline">
                                <uxap:blocks>
                                    <Text text="(Member 2 will put Timeline control here)" class="sapUiSmallMargin"/>
                                </uxap:blocks>
                            </uxap:ObjectPageSubSection>
                        </uxap:subSections>
                    </uxap:ObjectPageSection>

                </uxap:sections>
            </uxap:ObjectPageLayout>
        </content>
    </Page>
</mvc:View>