<mvc:View
    controllerName="sap.defectmgmt.controller.CreateIssue"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout"
    xmlns:u="sap.ui.unified">

    <Page
        id="createIssuePage"
        title="{i18n>createIssueTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>
            <layout:VerticalLayout width="100%" class="sapUiContentPadding">
                <form:SimpleForm
                    id="createIssueForm"
                    editable="true"
                    layout="ResponsiveGridLayout"
                    title="{i18n>createIssueDetails}"
                    labelSpanXL="3"
                    labelSpanL="3"
                    labelSpanM="4"
                    labelSpanS="12"
                    adjustLabelSpan="false"
                    emptySpanXL="4"
                    emptySpanL="4"
                    emptySpanM="4"
                    emptySpanS="0"
                    columnsXL="1"
                    columnsL="1"
                    columnsM="1">

                    <form:content>
                        <!-- Title Field -->
                        <Label text="{i18n>createIssueLabelTitle}" required="true"/>
                        <Input
                            id="inpTitle"
                            placeholder="{i18n>createIssueTitlePlaceholder}"
                            maxLength="80"
                            liveChange=".onFieldChange"/>

                        <!-- Description Field -->
                        <Label text="{i18n>createIssueLabelDescription}" required="true"/>
                        <TextArea
                            id="txtDescription"
                            placeholder="{i18n>createIssueDescPlaceholder}"
                            rows="8"
                            maxLength="1000"
                            liveChange=".onFieldChange"/>

                        <!-- Module Selection -->
                        <Label text="{i18n>createIssueLabelModule}" required="true"/>
                        <Select
                            id="selModule"
                            change=".onModuleChange">
                            <core:Item key="" text="{i18n>createIssueSelectModule}"/>
                            <core:Item key="FI" text="FI - Financial Accounting"/>
                            <core:Item key="MM" text="MM - Material Management"/>
                            <core:Item key="SD" text="SD - Sales &amp; Distribution"/>
                            <core:Item key="HCM" text="HCM - Human Capital Management"/>
                            <core:Item key="PP" text="PP - Production Planning"/>
                            <core:Item key="QM" text="QM - Quality Management"/>
                        </Select>

                        <!-- Severity Selection -->
                        <Label text="{i18n>createIssueLabelSeverity}" required="true"/>
                        <Select
                            id="selSeverity">
                            <core:Item key="LOW" text="{i18n>severityLow}"/>
                            <core:Item key="MEDIUM" text="{i18n>severityMedium}"/>
                            <core:Item key="HIGH" text="{i18n>severityHigh}"/>
                            <core:Item key="CRITICAL" text="{i18n>severityCritical}"/>
                        </Select>

                        <!-- Affected Version -->
                        <Label text="{i18n>createIssueLabelAffectedVersion}"/>
                        <Input
                            id="inpAffectedVersion"
                            value="1.0"
                            placeholder="{i18n>createIssueAffectedVersionPlaceholder}"/>

                        <!-- Due Date -->
                        <Label text="{i18n>createIssueLabelDueDate}" required="true"/>
                        <DatePicker
                            id="dpDueDate"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd.MM.yyyy"
                            change=".onFieldChange"/>

                        <!-- Developer Assignment -->
                        <Label text="{i18n>createIssueLabelAssignDeveloper}" required="false"/>
                        <Select
                            id="selDeveloper"
                            enabled="false">
                            <!-- Placeholder item to display if empty -->
                            <core:Item key="" text="{i18n>createIssueSelectDevFirst}"/>
                        </Select>
                        <Text id="txtDeveloperWorkloadInfo" text="" class="sapUiTinyMarginTop sapUiSubTemplates"/>

                        <!-- Attachment (optional) — uploaded after ticket is created -->
                        <Label text="{i18n>createIssueLabelAttachment}"/>
                        <VBox id="createAttachmentDropZone" class="attachmentDropZone">
                            <Text text="{i18n>attachmentDropHint}" class="sapUiTinyMarginBottom"/>
                            <u:FileUploader
                                id="fileUploader"
                                name="attachmentUpload"
                                buttonOnly="false"
                                icon="sap-icon://upload"
                                iconFirst="true"
                                buttonText="{i18n>createIssueUploadBtn}"
                                placeholder="{i18n>createIssueUploadPlaceholder}"
                                sameFilenameAllowed="true"
                                multiple="true"
                                change=".onFileChange"
                                width="100%"/>
                            <List
                                id="pendingAttachmentList"
                                items="{pendingAttachments>/files}"
                                noDataText="{i18n>createIssueNoAttachment}"
                                class="sapUiTinyMarginTop">
                                <StandardListItem
                                    title="{pendingAttachments>name}"
                                    description="{pendingAttachments>sizeText}"
                                    icon="{pendingAttachments>icon}"
                                    type="Active"
                                    press=".onRemovePendingFile"/>
                            </List>
                        </VBox>
                    </form:content>
                </form:SimpleForm>
            </layout:VerticalLayout>
        </content>

        <!-- Action Buttons Footer -->
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button
                    id="btnSubmit"
                    text="{i18n>createIssueSubmit}"
                    type="Emphasized"
                    press=".onSubmit"/>
                <Button
                    id="btnCancel"
                    text="{i18n>createIssueCancel}"
                    press=".onCancel"/>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
