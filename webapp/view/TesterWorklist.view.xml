<mvc:View
    controllerName="sap.defectmgmt.controller.TesterWorklist"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:ctrl="sap.defectmgmt.control">

    <Page
        id="testerWorklistPage"
        title="{i18n>testerWorklistTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <headerContent>
            <Button icon="sap-icon://refresh" tooltip="{i18n>dashboardRefreshTooltip}" press=".onRefresh"/>
            <Button icon="sap-icon://log" text="Logout" press=".onLogout" type="Transparent"/>
        </headerContent>

        <content>
            <IconTabBar id="testerTabBar" expanded="true" class="sapUiResponsiveContentPadding">
                <items>
                    <!-- TAB 1: My Tickets (created by tester) -->
                    <IconTabFilter
                        key="myTickets"
                        icon="sap-icon://create"
                        text="{i18n>testerWorklistTabMyTickets}">
                        <Table
                            id="testerMyTicketsTable"
                            items="{/issues}"
                            growing="true"
                            growingThreshold="20"
                            sticky="ColumnHeaders">
                            <noData>
                                <VBox alignItems="Center" justifyContent="Center" class="sapUiLargeMargin">
                                    <core:Icon src="sap-icon://create" size="4rem" color="#8a97a1" class="sapUiSmallMarginBottom"/>
                                    <Title text="{i18n>testerWorklistMyNoData}" level="H4"/>
                                </VBox>
                            </noData>
                             <columns>
                                <Column width="9rem" hAlign="Center">
                                    <header>
                                        <ctrl:TableHeaderCell
                                            text="{i18n>columnIssueNum}"
                                            columnKey="issue_num"
                                            sortField="issue_num"
                                            filterType="text"
                                            sortState="{filterState>/myTickets/columns/issue_num/sortState}"
                                            filterActive="{= !!${filterState>/myTickets/columns/issue_num/filter/query} }"
                                            filterValue="{filterState>/myTickets/columns/issue_num/filter}"
                                            sortChange=".onHeaderSort"
                                            filterChange=".onHeaderFilter"
                                            filterClear=".onHeaderFilterClear"/>
                                    </header>
                                </Column>
                                <Column hAlign="Left">
                                    <header>
                                        <ctrl:TableHeaderCell
                                            text="{i18n>columnTitle}"
                                            columnKey="title"
                                            sortField="title"
                                            filterType="text"
                                            sortState="{filterState>/myTickets/columns/title/sortState}"
                                            filterActive="{= !!${filterState>/myTickets/columns/title/filter/query} }"
                                            filterValue="{filterState>/myTickets/columns/title/filter}"
                                            sortChange=".onHeaderSort"
                                            filterChange=".onHeaderFilter"
                                            filterClear=".onHeaderFilterClear"/>
                                    </header>
                                </Column>
                                <Column width="8rem" hAlign="Center" demandPopin="true" minScreenWidth="Tablet">
                                    <header>
                                        <ctrl:TableHeaderCell
                                            text="{i18n>columnStatus}"
                                            columnKey="status"
                                            sortField="status"
                                            filterType="category"
                                            categoryOptions='[&quot;ASSIGNED&quot;,&quot;IN_PROGRESS&quot;,&quot;RESOLVED&quot;,&quot;TESTING&quot;,&quot;REOPEN&quot;,&quot;CLOSED&quot;]'
                                            sortState="{filterState>/myTickets/columns/status/sortState}"
                                            filterActive="{= ${filterState>/myTickets/columns/status/filter/selected}.length > 0 }"
                                            filterValue="{filterState>/myTickets/columns/status/filter}"
                                            sortChange=".onHeaderSort"
                                            filterChange=".onHeaderFilter"
                                            filterClear=".onHeaderFilterClear"/>
                                    </header>
                                </Column>
                                <Column width="9rem" hAlign="Center" demandPopin="true" minScreenWidth="Tablet">
                                    <header>
                                        <ctrl:TableHeaderCell
                                            text="{i18n>columnSeverity}"
                                            columnKey="severity"
                                            sortField="severity"
                                            filterType="category"
                                            categoryOptions='[&quot;CRITICAL&quot;,&quot;HIGH&quot;,&quot;MEDIUM&quot;,&quot;LOW&quot;]'
                                            sortState="{filterState>/myTickets/columns/severity/sortState}"
                                            filterActive="{= ${filterState>/myTickets/columns/severity/filter/selected}.length > 0 }"
                                            filterValue="{filterState>/myTickets/columns/severity/filter}"
                                            sortChange=".onHeaderSort"
                                            filterChange=".onHeaderFilter"
                                            filterClear=".onHeaderFilterClear"/>
                                    </header>
                                </Column>
                                <Column width="11rem" hAlign="Center" demandPopin="true" minScreenWidth="Desktop">
                                    <header>
                                        <ctrl:TableHeaderCell
                                            text="{i18n>columnAssignedTo}"
                                            columnKey="assigned_to"
                                            sortField="assigned_to"
                                            filterType="text"
                                            sortState="{filterState>/myTickets/columns/assigned_to/sortState}"
                                            filterActive="{= !!${filterState>/myTickets/columns/assigned_to/filter/query} }"
                                            filterValue="{filterState>/myTickets/columns/assigned_to/filter}"
                                            sortChange=".onHeaderSort"
                                            filterChange=".onHeaderFilter"
                                            filterClear=".onHeaderFilterClear"/>
                                    </header>
                                </Column>
                                <Column width="10rem" hAlign="Center" demandPopin="true" minScreenWidth="Desktop">
                                    <header>
                                        <ctrl:TableHeaderCell
                                            text="{i18n>columnDueDate}"
                                            columnKey="due_date"
                                            sortField="due_date"
                                            filterType="dateRange"
                                            sortState="{filterState>/myTickets/columns/due_date/sortState}"
                                            filterActive="{= !!${filterState>/myTickets/columns/due_date/filter/from} || !!${filterState>/myTickets/columns/due_date/filter/to} }"
                                            filterValue="{filterState>/myTickets/columns/due_date/filter}"
                                            sortChange=".onHeaderSort"
                                            filterChange=".onHeaderFilter"
                                            filterClear=".onHeaderFilterClear"/>
                                    </header>
                                </Column>
                                <Column width="8rem" hAlign="Center">
                                    <header>
                                        <ctrl:TableHeaderCell
                                            text="{i18n>columnSla}"
                                            columnKey="sla"
                                            sortable="false"
                                            filterType="slaStatus"
                                            filterActive="{= ${filterState>/myTickets/columns/sla/filter/selection} !== 'all' }"
                                            filterValue="{filterState>/myTickets/columns/sla/filter}"
                                            filterChange=".onHeaderFilter"
                                            filterClear=".onHeaderFilterClear"/>
                                    </header>
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem type="Navigation" vAlign="Middle" press=".onIssuePress">
                                    <cells>
                                        <ObjectIdentifier title="#{issue_num}"/>
                                        <Text text="{title}" maxLines="2"/>
                                        <ObjectStatus class="uniformPill" inverted="true" text="{ path: 'status', formatter: '.formatter.formatStatusText' }" state="{ path: 'status', formatter: '.formatter.formatStatusState' }"/>
                                        <ObjectStatus text="{severity}" state="{ path: 'severity', formatter: '.formatter.formatSeverityState' }" icon="{ path: 'severity', formatter: '.formatter.formatSeverityIcon' }"/>
                                        <Text text="{assigned_to}"/>
                                        <Text text="{ path: 'due_date', formatter: '.formatter.formatDate' }"/>
                                        <ObjectStatus text="{ parts: ['due_date', 'status'], formatter: '.formatter.formatOverdueText' }" state="{ parts: ['due_date', 'status'], formatter: '.formatter.formatOverdueState' }" icon="{ parts: ['due_date', 'status'], formatter: '.formatter.formatOverdueIcon' }"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <!-- TAB 2: Needs Verification (RESOLVED / TESTING) -->
                    <IconTabFilter
                        key="verification"
                        icon="sap-icon://inspection"
                        iconColor="Critical"
                        text="{i18n>testerWorklistTabVerification}">
                        <Table
                            id="testerVerificationTable"
                            items="{/issues}"
                            growing="true"
                            growingThreshold="20"
                            sticky="ColumnHeaders">
                            <noData>
                                <VBox alignItems="Center" justifyContent="Center" class="sapUiLargeMargin">
                                    <core:Icon src="sap-icon://inspection" size="4rem" color="#8a97a1" class="sapUiSmallMarginBottom"/>
                                    <Title text="{i18n>testerWorklistVerifyNoData}" level="H4"/>
                                </VBox>
                            </noData>
                             <columns>
                                <Column width="9rem" hAlign="Center">
                                    <header>
                                        <ctrl:TableHeaderCell
                                            text="{i18n>columnIssueNum}"
                                            columnKey="issue_num"
                                            sortField="issue_num"
                                            filterType="text"
                                            sortState="{filterState>/verification/columns/issue_num/sortState}"
                                            filterActive="{= !!${filterState>/verification/columns/issue_num/filter/query} }"
                                            filterValue="{filterState>/verification/columns/issue_num/filter}"
                                            sortChange=".onHeaderSort"
                                            filterChange=".onHeaderFilter"
                                            filterClear=".onHeaderFilterClear"/>
                                    </header>
                                </Column>
                                <Column hAlign="Left">
                                    <header>
                                        <ctrl:TableHeaderCell
                                            text="{i18n>columnTitle}"
                                            columnKey="title"
                                            sortField="title"
                                            filterType="text"
                                            sortState="{filterState>/verification/columns/title/sortState}"
                                            filterActive="{= !!${filterState>/verification/columns/title/filter/query} }"
                                            filterValue="{filterState>/verification/columns/title/filter}"
                                            sortChange=".onHeaderSort"
                                            filterChange=".onHeaderFilter"
                                            filterClear=".onHeaderFilterClear"/>
                                    </header>
                                </Column>
                                <Column width="8rem" hAlign="Center" demandPopin="true" minScreenWidth="Tablet">
                                    <header>
                                        <ctrl:TableHeaderCell
                                            text="{i18n>columnStatus}"
                                            columnKey="status"
                                            sortField="status"
                                            filterType="category"
                                            categoryOptions='[&quot;RESOLVED&quot;,&quot;TESTING&quot;]'
                                            sortState="{filterState>/verification/columns/status/sortState}"
                                            filterActive="{= ${filterState>/verification/columns/status/filter/selected}.length > 0 }"
                                            filterValue="{filterState>/verification/columns/status/filter}"
                                            sortChange=".onHeaderSort"
                                            filterChange=".onHeaderFilter"
                                            filterClear=".onHeaderFilterClear"/>
                                    </header>
                                </Column>
                                <Column width="9rem" hAlign="Center" demandPopin="true" minScreenWidth="Tablet">
                                    <header>
                                        <ctrl:TableHeaderCell
                                            text="{i18n>columnSeverity}"
                                            columnKey="severity"
                                            sortField="severity"
                                            filterType="category"
                                            categoryOptions='[&quot;CRITICAL&quot;,&quot;HIGH&quot;,&quot;MEDIUM&quot;,&quot;LOW&quot;]'
                                            sortState="{filterState>/verification/columns/severity/sortState}"
                                            filterActive="{= ${filterState>/verification/columns/severity/filter/selected}.length > 0 }"
                                            filterValue="{filterState>/verification/columns/severity/filter}"
                                            sortChange=".onHeaderSort"
                                            filterChange=".onHeaderFilter"
                                            filterClear=".onHeaderFilterClear"/>
                                    </header>
                                </Column>
                                <Column width="11rem" hAlign="Center" demandPopin="true" minScreenWidth="Desktop">
                                    <header>
                                        <ctrl:TableHeaderCell
                                            text="{i18n>columnAssignedTo}"
                                            columnKey="assigned_to"
                                            sortField="assigned_to"
                                            filterType="text"
                                            sortState="{filterState>/verification/columns/assigned_to/sortState}"
                                            filterActive="{= !!${filterState>/verification/columns/assigned_to/filter/query} }"
                                            filterValue="{filterState>/verification/columns/assigned_to/filter}"
                                            sortChange=".onHeaderSort"
                                            filterChange=".onHeaderFilter"
                                            filterClear=".onHeaderFilterClear"/>
                                    </header>
                                </Column>
                                <Column width="10rem" hAlign="Center" demandPopin="true" minScreenWidth="Desktop">
                                    <header>
                                        <ctrl:TableHeaderCell
                                            text="{i18n>columnDueDate}"
                                            columnKey="due_date"
                                            sortField="due_date"
                                            filterType="dateRange"
                                            sortState="{filterState>/verification/columns/due_date/sortState}"
                                            filterActive="{= !!${filterState>/verification/columns/due_date/filter/from} || !!${filterState>/verification/columns/due_date/filter/to} }"
                                            filterValue="{filterState>/verification/columns/due_date/filter}"
                                            sortChange=".onHeaderSort"
                                            filterChange=".onHeaderFilter"
                                            filterClear=".onHeaderFilterClear"/>
                                    </header>
                                </Column>
                                <Column width="8rem" hAlign="Center">
                                    <header>
                                        <ctrl:TableHeaderCell
                                            text="{i18n>columnSla}"
                                            columnKey="sla"
                                            sortable="false"
                                            filterType="slaStatus"
                                            filterActive="{= ${filterState>/verification/columns/sla/filter/selection} !== 'all' }"
                                            filterValue="{filterState>/verification/columns/sla/filter}"
                                            filterChange=".onHeaderFilter"
                                            filterClear=".onHeaderFilterClear"/>
                                    </header>
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem type="Navigation" vAlign="Middle" press=".onIssuePress">
                                    <cells>
                                        <ObjectIdentifier title="#{issue_num}"/>
                                        <Text text="{title}" maxLines="2"/>
                                        <ObjectStatus class="uniformPill" inverted="true" text="{ path: 'status', formatter: '.formatter.formatStatusText' }" state="{ path: 'status', formatter: '.formatter.formatStatusState' }"/>
                                        <ObjectStatus text="{severity}" state="{ path: 'severity', formatter: '.formatter.formatSeverityState' }" icon="{ path: 'severity', formatter: '.formatter.formatSeverityIcon' }"/>
                                        <Text text="{assigned_to}"/>
                                        <Text text="{ path: 'due_date', formatter: '.formatter.formatDate' }"/>
                                        <ObjectStatus text="{ parts: ['due_date', 'status'], formatter: '.formatter.formatOverdueText' }" state="{ parts: ['due_date', 'status'], formatter: '.formatter.formatOverdueState' }" icon="{ parts: ['due_date', 'status'], formatter: '.formatter.formatOverdueIcon' }"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>

</mvc:View>
