<!--
    IssueList.view.xml — Issue List Page

    Navigation entry point: displays a table of all defect tickets.
    Users click a row to navigate to the Issue Detail page.

    Features:
      - sap.m.Table bound to /Issue OData entity set
      - Column headers: Issue #, Title, Module, Severity, Status, Assigned To, Due Date
      - Status and Severity columns use ObjectStatus with color coding (via formatter)
      - Search bar filters by title or module
      - Module filter (FI/MM/SD) for narrowing results
      - Sort button with ActionSheet
      - Growing (lazy loading) enabled for performance

    Note: Role selector removed — role is now managed globally by the Login page
    via userModel/userRole JSON models.
-->
<mvc:View
    controllerName="sap.defectmgmt.controller.IssueList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="issueListPage"
        title=""
        showNavButton="false">

        <!-- Custom Header: SAP logo + title on left, actions on right -->
        <customHeader>
            <Bar>
                <contentLeft>
                    <Image src="https://ui5.sap.com/resources/sap/ui/documentation/sdk/images/logo_sap.png" height="1.5rem" class="sapUiSmallMarginBegin sapUiSmallMarginEnd" />
                    <Title text="{i18n>issueListTitle}" level="H2"/>
                </contentLeft>
                <contentRight>
                    <Title text="{i18n>appTitle}" titleStyle="H4" class="sapUiSmallMarginEnd"/>
                    <Text text="{userModel>/fullName}" visible="{= !!${userModel>/fullName} }" class="sapUiSmallMarginEnd"/>
                    <Button icon="sap-icon://add" text="Create Ticket" press=".onGoToCreate" type="Emphasized" visible="{= ${userModel>/role} === 'Tester' || ${userModel>/role} === 'Manager' }"/>
                    <Button icon="sap-icon://manager-insight" text="KPI Dashboard" press=".onGoToDashboard" visible="{= ${userModel>/role} === 'Manager' }"/>
                    <Button icon="sap-icon://log" text="Logout" press=".onLogout" type="Transparent"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <!-- ================================================ -->
            <!-- ISSUE TABLE                                       -->
            <!-- Bound to /Issue entity set from OData model       -->
            <!-- Growing enabled: loads 20 items at a time          -->
            <!-- ================================================ -->
            <Table
                id="issueTable"
                items="{/Issue}"
                growing="true"
                growingThreshold="20"
                sticky="ColumnHeaders,HeaderToolbar"
                class="sapUiSmallMargin">

                <!-- No Data State -->
                <noData>
                    <VBox alignItems="Center" justifyContent="Center" class="sapUiLargeMargin">
                        <core:Icon src="sap-icon://search" size="4rem" color="#8a97a1" class="sapUiSmallMarginBottom" />
                        <Title text="No defects found" level="H4"/>
                        <Text text="Try adjusting your search keyword or module filter." />
                    </VBox>
                </noData>

                <!-- Table Toolbar: Title, Sort, Module Filter, Search -->
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>issueListTableTitle}" level="H3"/>
                        <ToolbarSpacer/>

                        <!-- Sort Button -->
                        <Button icon="sap-icon://sort" press=".onSortPress" type="Transparent"
                            tooltip="Sort issues"/>

                        <!-- Module Filter Dropdown -->
                        <Select id="filterModule" change=".onFilterModule" width="150px">
                            <core:Item key="" text="All Modules" />
                            <core:Item key="FI" text="FI" />
                            <core:Item key="MM" text="MM" />
                            <core:Item key="SD" text="SD" />
                        </Select>

                        <!-- Search Field -->
                        <SearchField
                            id="searchField"
                            width="250px"
                            placeholder="{i18n>searchPlaceholder}"
                            search=".onSearch"/>
                    </OverflowToolbar>
                </headerToolbar>

                <!-- Column Definitions -->
                <columns>
                    <Column width="5.5rem" hAlign="Center">
                        <Text text="{i18n>columnIssueNum}"/>
                    </Column>
                    <Column hAlign="Left">
                        <Text text="{i18n>columnTitle}"/>
                    </Column>
                    <Column width="8rem" hAlign="Center" demandPopin="true" minScreenWidth="Tablet">
                        <Text text="{i18n>columnModule}"/>
                    </Column>
                    <Column width="7rem" hAlign="Center" demandPopin="true" minScreenWidth="Tablet">
                        <Text text="{i18n>columnSeverity}"/>
                    </Column>
                    <Column width="8rem" hAlign="Center">
                        <Text text="{i18n>columnStatus}"/>
                    </Column>
                    <Column width="8rem" hAlign="Center" demandPopin="true" minScreenWidth="Desktop">
                        <Text text="{i18n>columnAssignedTo}"/>
                    </Column>
                    <Column width="7rem" hAlign="Center" demandPopin="true" minScreenWidth="Desktop">
                        <Text text="{i18n>columnDueDate}"/>
                    </Column>
                </columns>

                <!-- Row Template — each row navigates to detail on press -->
                <items>
                    <ColumnListItem type="Navigation" vAlign="Middle" press=".onIssuePress">
                        <cells>
                            <!-- Issue Number (formatted as #1001) -->
                            <ObjectIdentifier title="#{issue_num}"/>

                            <!-- Title (truncated to 2 lines) -->
                            <Text text="{title}" maxLines="2"/>

                            <!-- Module badge — ObjectStatus with inverted styling matching Status column -->
                            <ObjectStatus
                                class="uniformPill"
                                inverted="true"
                                text="{modulename}"
                                state="{= ${modulename} === 'FI' ? 'Indication01' : ${modulename} === 'MM' ? 'Indication02' : ${modulename} === 'SD' ? 'Indication03' : 'Indication04' }"
                            />

                            <!-- Severity with icon and color -->
                            <ObjectStatus
                                text="{severity}"
                                state="{
                                    path: 'severity',
                                    formatter: '.formatter.formatSeverityState'
                                }"
                                icon="{
                                    path: 'severity',
                                    formatter: '.formatter.formatSeverityIcon'
                                }"/>

                            <!-- Status — consistent ObjectStatus with inverted pill styling -->
                            <ObjectStatus
                                class="uniformPill"
                                text="{
                                    path: 'status',
                                    formatter: '.formatter.formatStatusText'
                                }"
                                state="{
                                    path: 'status',
                                    formatter: '.formatter.formatStatusState'
                                }"
                                inverted="true"/>

                            <!-- Assigned Developer -->
                            <Text text="{assigned_to}"/>

                            <!-- Due Date (formatted DD.MM.YYYY) -->
                            <Text text="{
                                path: 'due_date',
                                formatter: '.formatter.formatDate'
                            }"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

    </Page>

</mvc:View>
