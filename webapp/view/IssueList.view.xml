<!--
    IssueList.view.xml — All Issues table.
    Every column uses the reusable TableHeaderCell for sort and filter actions.
-->
<mvc:View
    controllerName="sap.defectmgmt.controller.IssueList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:ctrl="sap.defectmgmt.control">

    <Page id="issueListPage" title="" showNavButton="false">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Image src="https://ui5.sap.com/resources/sap/ui/documentation/sdk/images/logo_sap.png" height="1.5rem" class="sapUiSmallMarginBegin sapUiSmallMarginEnd" />
                    <Title text="{i18n>issueListTitle}" level="H2"/>
                </contentLeft>
                <contentRight>
                    <Title text="{i18n>appTitle}" titleStyle="H4" class="sapUiSmallMarginEnd"/>
                    <Text text="{userModel>/fullName}" visible="{= !!${userModel>/fullName} }" class="sapUiSmallMarginEnd"/>
                    <Button icon="sap-icon://task" text="{i18n>navMyWork}" press=".onGoToDeveloperWorklist" visible="{= ${userModel>/role} === 'Developer' }"/>
                    <Button icon="sap-icon://inspection" text="{i18n>navVerification}" press=".onGoToTesterWorklist" visible="{= ${userModel>/role} === 'Tester' || ${userModel>/role} === 'Manager' }"/>
                    <Button icon="sap-icon://add" text="{i18n>btnCreateTicket}" press=".onGoToCreate" type="Emphasized" visible="{= ${userModel>/role} === 'Tester' || ${userModel>/role} === 'Manager' }"/>
                    <Button icon="sap-icon://manager-insight" text="{i18n>navDashboard}" press=".onGoToDashboard" visible="{= ${userModel>/role} === 'Manager' }"/>
                    <Button icon="sap-icon://log" text="Logout" press=".onLogout" type="Transparent"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <!-- Custom Filter Options Panel -->
            <Panel headerText="Filter Options" expandable="true" expanded="true" class="sapUiSmallMargin">
                <HBox wrap="Wrap" alignItems="Center">
                    <!-- Module Filter -->
                    <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                        <Label text="Module:" style="font-weight: bold;"/>
                        <MultiComboBox
                            id="filterModule"
                            width="12rem"
                            selectionFinish=".onFilterChange"
                            selectedKeys="{filterState>/columns/modulename/filter/selected}">
                            <core:Item key="FI" text="FI - Finance"/>
                            <core:Item key="CO" text="CO - Controlling"/>
                            <core:Item key="SD" text="SD - Sales &amp; Distribution"/>
                            <core:Item key="MM" text="MM - Material Management"/>
                            <core:Item key="PP" text="PP - Production Planning"/>
                            <core:Item key="HCM" text="HCM - Human Capital Mgmt"/>
                            <core:Item key="QM" text="QM - Quality Management"/>
                        </MultiComboBox>
                    </VBox>

                    <!-- Severity Filter -->
                    <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                        <Label text="Severity:" style="font-weight: bold;"/>
                        <MultiComboBox
                            id="filterSeverity"
                            width="10rem"
                            selectionFinish=".onFilterChange"
                            selectedKeys="{filterState>/columns/severity/filter/selected}">
                            <core:Item key="CRITICAL" text="Critical"/>
                            <core:Item key="HIGH" text="High"/>
                            <core:Item key="MEDIUM" text="Medium"/>
                            <core:Item key="LOW" text="Low"/>
                        </MultiComboBox>
                    </VBox>

                    <!-- Status Filter -->
                    <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                        <Label text="Status:" style="font-weight: bold;"/>
                        <MultiComboBox
                            id="filterStatus"
                            width="11rem"
                            selectionFinish=".onFilterChange"
                            selectedKeys="{filterState>/columns/status/filter/selected}">
                            <core:Item key="ASSIGNED" text="Assigned"/>
                            <core:Item key="IN_PROGRESS" text="In Progress"/>
                            <core:Item key="RESOLVED" text="Resolved"/>
                            <core:Item key="TESTING" text="Testing"/>
                            <core:Item key="REOPEN" text="Reopened"/>
                            <core:Item key="CLOSED" text="Closed"/>
                        </MultiComboBox>
                    </VBox>

                    <!-- Assigned To Filter -->
                    <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                        <Label text="Assigned To:" style="font-weight: bold;"/>
                        <SearchField
                            id="filterAssignedTo"
                            width="12rem"
                            placeholder="Search developer..."
                            search=".onFilterChange"
                            value="{filterState>/columns/assigned_to/filter/query}"/>
                    </VBox>

                    <!-- Due Date Filter -->
                    <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                        <Label text="Due Date Range:" style="font-weight: bold;"/>
                        <DateRangeSelection
                            id="filterDueDate"
                            width="14rem"
                            change=".onFilterChange"
                            dateValue="{filterState>/columns/due_date/filter/from}"
                            secondDateValue="{filterState>/columns/due_date/filter/to}"/>
                    </VBox>

                    <!-- SLA Filter -->
                    <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                        <Label text="SLA Status:" style="font-weight: bold;"/>
                        <Select
                            id="filterSla"
                            width="10rem"
                            change=".onFilterChange"
                            selectedKey="{filterState>/columns/sla/filter/selection}">
                            <core:Item key="all" text="All Tickets"/>
                            <core:Item key="overdue" text="Overdue Tickets"/>
                            <core:Item key="onTrack" text="On Track"/>
                        </Select>
                    </VBox>

                    <!-- Clear Filters Button -->
                    <VBox class="sapUiTinyMarginBottom" justifyContent="End" style="height: 3rem;">
                        <Button
                            text="Clear Filters"
                            icon="sap-icon://clear-filter"
                            press=".onClearAllFilters"
                            type="Transparent"/>
                    </VBox>
                </HBox>
            </Panel>

            <Table
                id="issueTable"
                items="{/Issue}"
                growing="true"
                growingThreshold="20"
                sticky="ColumnHeaders,HeaderToolbar"
                class="sapUiSmallMargin">

                <noData>
                    <VBox alignItems="Center" justifyContent="Center" class="sapUiLargeMargin">
                        <core:Icon src="sap-icon://search" size="4rem" color="#8a97a1" class="sapUiSmallMarginBottom" />
                        <Title text="No defects found" level="H4"/>
                        <Text text="Try adjusting the column filters." />
                    </VBox>
                </noData>

                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>issueListTableTitle}" level="H3"/>
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column width="9rem" hAlign="Center">
                        <header>
                            <ctrl:TableHeaderCell
                                text="{i18n>columnIssueNum}"
                                columnKey="issue_num"
                                sortField="issue_num"
                                filterType="text"
                                sortState="{filterState>/columns/issue_num/sortState}"
                                filterActive="{= !!${filterState>/columns/issue_num/filter/query} }"
                                filterValue="{filterState>/columns/issue_num/filter}"
                                sortChange=".onHeaderSort"
                                filterChange=".onHeaderFilter"
                                filterClear=".onHeaderFilterClear"/>
                        </header>
                    </Column>
                    <Column hAlign="Left">
                        <header>
                            <ctrl:TableHeaderCell
                                text="{i18n>columnTitle}"
                                columnKey="title"
                                sortField="title"
                                filterType="text"
                                sortState="{filterState>/columns/title/sortState}"
                                filterActive="{= !!${filterState>/columns/title/filter/query} }"
                                filterValue="{filterState>/columns/title/filter}"
                                sortChange=".onHeaderSort"
                                filterChange=".onHeaderFilter"
                                filterClear=".onHeaderFilterClear"/>
                        </header>
                    </Column>
                    <Column width="9.5rem" hAlign="Center" demandPopin="true" minScreenWidth="Tablet">
                        <header>
                            <ctrl:TableHeaderCell
                                text="{i18n>columnModule}"
                                columnKey="modulename"
                                sortField="modulename"
                                filterType="category"
                                categoryOptions='[&quot;FI&quot;,&quot;MM&quot;,&quot;SD&quot;,&quot;HCM&quot;,&quot;PP&quot;,&quot;QM&quot;]'
                                sortState="{filterState>/columns/modulename/sortState}"
                                filterActive="{= ${filterState>/columns/modulename/filter/selected}.length > 0 }"
                                filterValue="{filterState>/columns/modulename/filter}"
                                sortChange=".onHeaderSort"
                                filterChange=".onHeaderFilter"
                                filterClear=".onHeaderFilterClear"/>
                        </header>
                    </Column>
                    <Column width="9rem" hAlign="Center" demandPopin="true" minScreenWidth="Tablet">
                        <header>
                            <ctrl:TableHeaderCell
                                text="{i18n>columnSeverity}"
                                columnKey="severity"
                                sortField="severity"
                                filterType="category"
                                categoryOptions='[&quot;CRITICAL&quot;,&quot;HIGH&quot;,&quot;MEDIUM&quot;,&quot;LOW&quot;]'
                                sortState="{filterState>/columns/severity/sortState}"
                                filterActive="{= ${filterState>/columns/severity/filter/selected}.length > 0 }"
                                filterValue="{filterState>/columns/severity/filter}"
                                sortChange=".onHeaderSort"
                                filterChange=".onHeaderFilter"
                                filterClear=".onHeaderFilterClear"/>
                        </header>
                    </Column>
                    <Column width="9rem" hAlign="Center">
                        <header>
                            <ctrl:TableHeaderCell
                                text="{i18n>columnStatus}"
                                columnKey="status"
                                sortField="status"
                                filterType="category"
                                categoryOptions='[&quot;ASSIGNED&quot;,&quot;IN_PROGRESS&quot;,&quot;RESOLVED&quot;,&quot;TESTING&quot;,&quot;CLOSED&quot;,&quot;REOPEN&quot;]'
                                sortState="{filterState>/columns/status/sortState}"
                                filterActive="{= ${filterState>/columns/status/filter/selected}.length > 0 }"
                                filterValue="{filterState>/columns/status/filter}"
                                sortChange=".onHeaderSort"
                                filterChange=".onHeaderFilter"
                                filterClear=".onHeaderFilterClear"/>
                        </header>
                    </Column>
                    <Column width="11rem" hAlign="Center" demandPopin="true" minScreenWidth="Desktop">
                        <header>
                            <ctrl:TableHeaderCell
                                text="{i18n>columnAssignedTo}"
                                columnKey="assigned_to"
                                sortField="assigned_to"
                                filterType="text"
                                sortState="{filterState>/columns/assigned_to/sortState}"
                                filterActive="{= !!${filterState>/columns/assigned_to/filter/query} }"
                                filterValue="{filterState>/columns/assigned_to/filter}"
                                sortChange=".onHeaderSort"
                                filterChange=".onHeaderFilter"
                                filterClear=".onHeaderFilterClear"/>
                        </header>
                    </Column>
                    <Column width="10rem" hAlign="Center" demandPopin="true" minScreenWidth="Desktop">
                        <header>
                            <ctrl:TableHeaderCell
                                text="{i18n>columnDueDate}"
                                columnKey="due_date"
                                sortField="due_date"
                                filterType="dateRange"
                                sortState="{filterState>/columns/due_date/sortState}"
                                filterActive="{= !!${filterState>/columns/due_date/filter/from} || !!${filterState>/columns/due_date/filter/to} }"
                                filterValue="{filterState>/columns/due_date/filter}"
                                sortChange=".onHeaderSort"
                                filterChange=".onHeaderFilter"
                                filterClear=".onHeaderFilterClear"/>
                        </header>
                    </Column>
                    <Column width="8rem" hAlign="Center" demandPopin="true" minScreenWidth="Tablet">
                        <header>
                            <ctrl:TableHeaderCell
                                text="{i18n>columnSla}"
                                columnKey="sla"
                                sortable="false"
                                filterType="slaStatus"
                                sortState="{filterState>/columns/sla/sortState}"
                                filterActive="{= ${filterState>/columns/sla/filter/selection} !== 'all' }"
                                filterValue="{filterState>/columns/sla/filter}"
                                filterChange=".onHeaderFilter"
                                filterClear=".onHeaderFilterClear"/>
                        </header>
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Navigation" vAlign="Middle" press=".onIssuePress">
                        <cells>
                            <ObjectIdentifier title="#{issue_num}"/>
                            <Text text="{title}" maxLines="2"/>
                            <ObjectStatus
                                class="uniformPill"
                                inverted="true"
                                text="{modulename}"
                                state="{= ${modulename} === 'FI' ? 'Indication01' : ${modulename} === 'MM' ? 'Indication02' : ${modulename} === 'SD' ? 'Indication03' : 'Indication04' }"/>
                            <ObjectStatus
                                text="{severity}"
                                state="{ path: 'severity', formatter: '.formatter.formatSeverityState' }"
                                icon="{ path: 'severity', formatter: '.formatter.formatSeverityIcon' }"/>
                            <ObjectStatus
                                class="uniformPill"
                                text="{ path: 'status', formatter: '.formatter.formatStatusText' }"
                                state="{ path: 'status', formatter: '.formatter.formatStatusState' }"
                                inverted="true"/>
                            <Text text="{assigned_to}"/>
                            <Text text="{ path: 'due_date', formatter: '.formatter.formatDate' }"/>
                            <ObjectStatus
                                text="{ parts: ['due_date', 'status'], formatter: '.formatter.formatOverdueText' }"
                                state="{ parts: ['due_date', 'status'], formatter: '.formatter.formatOverdueState' }"
                                icon="{ parts: ['due_date', 'status'], formatter: '.formatter.formatOverdueIcon' }"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
