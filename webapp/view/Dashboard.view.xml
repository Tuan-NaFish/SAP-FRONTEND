<mvc:View
    controllerName="sap.defectmgmt.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:cssgrid="sap.ui.layout.cssgrid"
    xmlns:core="sap.ui.core"
    xmlns:mc="sap.suite.ui.microchart">
    
    <Page id="dashboardPage" showHeader="false">
        <content>
            <f:ShellBar 
                title="SAP Defect Management System" 
                homeIcon="https://ui5.sap.com/resources/sap/ui/documentation/sdk/images/logo_sap.png"
                showNotifications="true"
                notificationsNumber="2"
                notificationsPressed=".onNotificationPress" />
            
            <VBox class="sapUiMediumMargin">
                <Title text="Dashboard &amp; Defect Metrics" level="H2" class="sapUiBottomMargin"/>
                
                <cssgrid:CSSGrid gridTemplateColumns="repeat(auto-fit, minmax(250px, 1fr))" gridGap="1rem">
                    <f:Card><f:header><card:NumericHeader title="Total Open Defects" number="{kpiModel>/TotalOpen}" scale="Tickets" state="Error"/></f:header></f:Card>
                    <f:Card><f:header><card:NumericHeader title="Mean Time To Resolve" number="{kpiModel>/MTTR}" state="Critical"/></f:header></f:Card>
                    <f:Card><f:header><card:NumericHeader title="Critical Bugs" number="{kpiModel>/CriticalCount}" scale="Bugs" state="Error"/></f:header></f:Card>
                    <f:Card><f:header><card:NumericHeader title="SLA Compliance" number="{kpiModel>/SLACompliance}" scale="%" state="Good"/></f:header></f:Card>
                </cssgrid:CSSGrid>

        <!-- Charts -->
        <cssgrid:CSSGrid gridTemplateColumns="repeat(auto-fit, minmax(400px, 1fr))" gridGap="1rem" class="sapUiSmallMargin">
            
            <f:Card>
                <f:header>
                    <card:Header title="Severity Distribution" iconSrc="sap-icon://donut-chart" />
                </f:header>
                <f:content>
                    <VBox width="100%" height="250px" class="sapUiSmallMargin">
                        <mc:InteractiveDonutChart id="severityChart" displayedSegments="4" selectionChanged=".onChartSelect">
                            <mc:segments>
                                <mc:InteractiveDonutChartSegment label="Critical" value="3" />
                                <mc:InteractiveDonutChartSegment label="High" value="5" />
                                <mc:InteractiveDonutChartSegment label="Medium" value="4" />
                                <mc:InteractiveDonutChartSegment label="Low" value="2" />
                            </mc:segments>
                        </mc:InteractiveDonutChart>
                    </VBox>
                </f:content>
            </f:Card>

            <f:Card>
                <f:header>
                    <card:Header title="Module Analysis" iconSrc="sap-icon://horizontal-bar-chart" />
                </f:header>
                <f:content>
                    <VBox width="100%" height="250px" class="sapUiSmallMargin">
                        <mc:InteractiveBarChart id="moduleChart" selectionChanged=".onModuleChartSelect">
                            <mc:bars>
                                <mc:InteractiveBarChartBar label="FI" value="2" color="Error" />
                                <mc:InteractiveBarChartBar label="MM" value="1" color="Critical" />
                                <mc:InteractiveBarChartBar label="SD" value="2" color="Good" />
                            </mc:bars>
                        </mc:InteractiveBarChart>
                    </VBox>
                </f:content>
            </f:Card>
            
        </cssgrid:CSSGrid>

                <Table id="defectTable" items="{path: 'defectModel>/'}" class="sapUiTopMargin">
                    
                    <noData>
                <VBox alignItems="Center" justifyContent="Center" class="sapUiLargeMargin">
                    <core:Icon src="sap-icon://search" size="4rem" color="#8a97a1" class="sapUiSmallMarginBottom" />
                    <Title text="No defects found" level="H4" class="sapUiTinyMarginBottom" />
                    <Text text="Try adjusting your search keyword or module filter." />
                </VBox>
            </noData>

                    <headerToolbar>
                        <Toolbar>
                            <Title text="Open Defects" level="H2"/>
                            <ToolbarSpacer/>
                            
                            <Button icon="sap-icon://sort" press=".onSortPress" type="Transparent" tooltip="Sort Tickets" class="sapUiSmallMarginEnd" />
                            
                            <Select id="filterModule" change=".onFilter" width="150px" class="sapUiSmallMarginEnd">
                                <core:Item key="" text="All Modules" />
                                <core:Item key="FI" text="FI" />
                                <core:Item key="MM" text="MM" />
                                <core:Item key="SD" text="SD" />
                            </Select>
                            
                            <SearchField id="searchField" width="250px" class="sapUiSmallMarginEnd" liveChange=".onFilter" placeholder="Search by Title..." />
                            
                            <Button text="Create Issue" icon="sap-icon://add" type="Emphasized" press=".onCreateIssuePress" />
                        </Toolbar>
                    </headerToolbar>

                    <columns>
                        <Column><Text text="ID"/></Column>
                        <Column><Text text="Title"/></Column>
                        <Column><Text text="Module"/></Column>
                        <Column><Text text="Severity"/></Column>
                        <Column><Text text="Status"/></Column>
                        <Column><Text text="Assignee"/></Column>
                    </columns>

                    <items>
                        <ColumnListItem type="Navigation" press=".onIssuePress">
                            <cells>
                                <Text text="{defectModel>ISSUE_ID}" />
                                <Text text="{defectModel>TITLE}" />
                                <Text text="{defectModel>MODULE}" />

                                <ObjectStatus 
                                    text="{defectModel>SEVERITY}" 
                                    state="{= ${defectModel>SEVERITY} === 'Critical' ? 'Error' : ${defectModel>SEVERITY} === 'High' ? 'Warning' : ${defectModel>SEVERITY} === 'Medium' ? 'Success' : 'None' }" 
                                    inverted="true" />

                                <ObjectStatus 
                                    text="{defectModel>STATUS}" 
                                    state="{= ${defectModel>STATUS} === 'NEW' ? 'Information' : ${defectModel>STATUS} === 'IN_PROGRESS' ? 'Warning' : ${defectModel>STATUS} === 'RESOLVED' ? 'Success' : 'None' }" 
                                    inverted="true" />

                                <Text text="{defectModel>ASSIGNED_TO}" />
                            </cells>
                        </ColumnListItem>
                    </items>

                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>