<mvc:View
    controllerName="sap.defectmgmt.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:f="sap.f"
    xmlns:cssgrid="sap.ui.layout.cssgrid">

    <Page
        id="dashboardPage"
        title="{i18n>dashboardPageTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <headerContent>
            <!-- Refresh button -->
            <Button icon="sap-icon://refresh" tooltip="{i18n>dashboardRefreshTooltip}" press=".onRefreshData"/>
            <Button icon="sap-icon://log" text="Logout" press=".onLogout" type="Transparent"/>
        </headerContent>

        <content>
            <!-- ======================================================== -->
            <!-- 1. KPI TILES CONTAINER                                   -->
            <!-- ======================================================== -->
            <layout:VerticalLayout width="100%" class="sapUiSmallMargin">

                <!-- Critical Defect Red Alert (shown when open critical count >= threshold) -->
                <!-- Critical Defect Red Alert (expression binding — no derivable state in model) -->
                <MessageStrip
                    text="{ parts: ['dashboardData>/totalCritical', 'dashboardData>/criticalThreshold'], formatter: '.formatCriticalAlertText' }"
                    type="Error"
                    showIcon="true"
                    visible="{= ${dashboardData>/totalCritical} >= ${dashboardData>/criticalThreshold} }"
                    class="sapUiSmallMarginBottom"/>

                <Title text="{i18n>dashboardKpiTitle}" level="H2" class="sapUiSmallMarginBottom"/>

                <HBox wrap="Wrap" class="sapUiTinyMarginBottom">
                    <!-- Total Open KPI -->
                    <GenericTile header="{i18n>kpiTotalOpen}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" press=".onKpiTilePress" valueColor="Critical">
                        <customData>
                            <core:CustomData key="kpiType" value="totalOpen" />
                        </customData>
                        <TileContent>
                            <NumericContent value="{dashboardData>/totalOpen}" valueColor="Critical" icon="sap-icon://active-folder"/>
                        </TileContent>
                    </GenericTile>

                    <!-- Overdue KPI -->
                    <GenericTile header="{i18n>kpiOverdue}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" press=".onKpiTilePress">
                        <customData>
                            <core:CustomData key="kpiType" value="overdue" />
                        </customData>
                        <TileContent>
                            <NumericContent value="{dashboardData>/totalOverdue}" valueColor="Error" icon="sap-icon://alert"/>
                        </TileContent>
                    </GenericTile>

                    <!-- Critical SLA KPI -->
                    <GenericTile header="{i18n>kpiCritical}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" press=".onKpiTilePress">
                        <customData>
                            <core:CustomData key="kpiType" value="critical" />
                        </customData>
                        <TileContent>
                            <NumericContent value="{dashboardData>/totalCritical}" valueColor="Error" icon="sap-icon://warning2"/>
                        </TileContent>
                    </GenericTile>

                    <!-- Resolved (Waiting Test) KPI -->
                    <GenericTile header="{i18n>kpiWaitingTesting}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" press=".onKpiTilePress">
                        <customData>
                            <core:CustomData key="kpiType" value="waitingTesting" />
                        </customData>
                        <TileContent>
                            <NumericContent value="{dashboardData>/totalTesting}" valueColor="Neutral" icon="sap-icon://user-settings"/>
                        </TileContent>
                    </GenericTile>

                    <!-- Closed KPI -->
                    <GenericTile header="{i18n>kpiClosed}" frameType="OneByOne" class="sapUiTinyMarginBottom" press=".onKpiTilePress">
                        <customData>
                            <core:CustomData key="kpiType" value="closed" />
                        </customData>
                        <TileContent>
                            <NumericContent value="{dashboardData>/totalClosed}" valueColor="Good" icon="sap-icon://accept"/>
                        </TileContent>
                    </GenericTile>
                </HBox>

                <core:HTML content="&lt;hr style='border: none; border-top: 1px solid #e5e5e5; margin: 1.5rem 0;' /&gt;"/>

                <!-- ======================================================== -->
                <!-- 2. DEFECT BREAKDOWNS (PROGRESS BARS)                     -->
                <!-- ======================================================== -->
                <Title text="{i18n>dashboardDistributionTitle}" level="H2" class="sapUiSmallMarginBottom"/>

                <HBox wrap="Wrap" justifyContent="SpaceBetween">
                    <!-- Status Distribution Panel -->
                    <Panel width="100%" class="sapUiResponsiveMargin sapUiNoContentPadding" headerText="{i18n>dashboardStatusDistribution}" expandable="true" expanded="true">
                        <layout:Grid defaultSpan="XL4 L4 M6 S12" class="sapUiSmallMargin">
                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="{i18n>dashboardAssignedLabel}"/>
                                    <Text text="{dashboardData>/status/ASSIGNED} / {dashboardData>/totalTickets}"/>
                                </HBox>
                                <ProgressIndicator
                                    percentValue="{dashboardData>/statusPercent/ASSIGNED}"
                                    displayValue="{dashboardData>/statusPercent/ASSIGNED}%"
                                    state="Information"/>
                            </VBox>

                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="{i18n>dashboardInProgressLabel}"/>
                                    <Text text="{dashboardData>/status/IN_PROGRESS} / {dashboardData>/totalTickets}"/>
                                </HBox>
                                <ProgressIndicator
                                    percentValue="{dashboardData>/statusPercent/IN_PROGRESS}"
                                    displayValue="{dashboardData>/statusPercent/IN_PROGRESS}%"
                                    state="Warning"/>
                            </VBox>

                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="{i18n>dashboardResolvedLabel}"/>
                                    <Text text="{dashboardData>/status/RESOLVED} / {dashboardData>/totalTickets}"/>
                                </HBox>
                                <ProgressIndicator
                                    percentValue="{dashboardData>/statusPercent/RESOLVED}"
                                    displayValue="{dashboardData>/statusPercent/RESOLVED}%"
                                    state="Success"/>
                            </VBox>

                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="{i18n>dashboardTestingLabel}"/>
                                    <Text text="{dashboardData>/status/TESTING} / {dashboardData>/totalTickets}"/>
                                </HBox>
                                <ProgressIndicator
                                    percentValue="{dashboardData>/statusPercent/TESTING}"
                                    displayValue="{dashboardData>/statusPercent/TESTING}%"
                                    state="None"/>
                            </VBox>

                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="{i18n>dashboardReopenedLabel}"/>
                                    <Text text="{dashboardData>/status/REOPEN} / {dashboardData>/totalTickets}"/>
                                </HBox>
                                <ProgressIndicator
                                    percentValue="{dashboardData>/statusPercent/REOPEN}"
                                    displayValue="{dashboardData>/statusPercent/REOPEN}%"
                                    state="Error"/>
                            </VBox>

                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="{i18n>dashboardClosedLabel}"/>
                                    <Text text="{dashboardData>/status/CLOSED} / {dashboardData>/totalTickets}"/>
                                </HBox>
                                <ProgressIndicator
                                    percentValue="{dashboardData>/statusPercent/CLOSED}"
                                    displayValue="{dashboardData>/statusPercent/CLOSED}%"
                                    state="Success"/>
                            </VBox>
                        </layout:Grid>
                    </Panel>
                </HBox>

                <HBox wrap="Wrap" justifyContent="SpaceBetween">
                    <!-- Severity Distribution Panel -->
                    <Panel width="100%" class="sapUiResponsiveMargin sapUiNoContentPadding" headerText="{i18n>dashboardSeverityDistribution}" expandable="true" expanded="true">
                        <layout:Grid defaultSpan="XL3 L3 M6 S12" class="sapUiSmallMargin">
                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="{i18n>dashboardCriticalLabel}"/>
                                    <Text text="{dashboardData>/severity/CRITICAL} / {dashboardData>/totalTickets}"/>
                                </HBox>
                                <ProgressIndicator
                                    percentValue="{dashboardData>/severityPercent/CRITICAL}"
                                    displayValue="{dashboardData>/severityPercent/CRITICAL}%"
                                    state="Error"/>
                            </VBox>

                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="{i18n>dashboardHighLabel}"/>
                                    <Text text="{dashboardData>/severity/HIGH} / {dashboardData>/totalTickets}"/>
                                </HBox>
                                <ProgressIndicator
                                    percentValue="{dashboardData>/severityPercent/HIGH}"
                                    displayValue="{dashboardData>/severityPercent/HIGH}%"
                                    state="Warning"/>
                            </VBox>

                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="{i18n>dashboardMediumLabel}"/>
                                    <Text text="{dashboardData>/severity/MEDIUM} / {dashboardData>/totalTickets}"/>
                                </HBox>
                                <ProgressIndicator
                                    percentValue="{dashboardData>/severityPercent/MEDIUM}"
                                    displayValue="{dashboardData>/severityPercent/MEDIUM}%"
                                    state="None"/>
                            </VBox>

                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="{i18n>dashboardLowLabel}"/>
                                    <Text text="{dashboardData>/severity/LOW} / {dashboardData>/totalTickets}"/>
                                </HBox>
                                <ProgressIndicator
                                    percentValue="{dashboardData>/severityPercent/LOW}"
                                    displayValue="{dashboardData>/severityPercent/LOW}%"
                                    state="Success"/>
                            </VBox>
                        </layout:Grid>
                    </Panel>
                </HBox>

                <HBox wrap="Wrap" justifyContent="SpaceBetween">
                    <!-- Module Distribution Panel -->
                    <Panel width="100%" class="sapUiResponsiveMargin sapUiNoContentPadding" headerText="{i18n>dashboardModuleDistribution}" expandable="true" expanded="true">
                        <layout:Grid defaultSpan="XL2 L2 M4 S12" class="sapUiSmallMargin">
                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="FI"/>
                                    <Text text="{dashboardData>/module/FI}"/>
                                </HBox>
                                <ProgressIndicator percentValue="{dashboardData>/modulePercent/FI}" displayValue="{dashboardData>/modulePercent/FI}%" state="Information"/>
                            </VBox>
                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="MM"/>
                                    <Text text="{dashboardData>/module/MM}"/>
                                </HBox>
                                <ProgressIndicator percentValue="{dashboardData>/modulePercent/MM}" displayValue="{dashboardData>/modulePercent/MM}%" state="Information"/>
                            </VBox>
                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="SD"/>
                                    <Text text="{dashboardData>/module/SD}"/>
                                </HBox>
                                <ProgressIndicator percentValue="{dashboardData>/modulePercent/SD}" displayValue="{dashboardData>/modulePercent/SD}%" state="Information"/>
                            </VBox>
                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="HCM"/>
                                    <Text text="{dashboardData>/module/HCM}"/>
                                </HBox>
                                <ProgressIndicator percentValue="{dashboardData>/modulePercent/HCM}" displayValue="{dashboardData>/modulePercent/HCM}%" state="Information"/>
                            </VBox>
                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="PP"/>
                                    <Text text="{dashboardData>/module/PP}"/>
                                </HBox>
                                <ProgressIndicator percentValue="{dashboardData>/modulePercent/PP}" displayValue="{dashboardData>/modulePercent/PP}%" state="Information"/>
                            </VBox>
                            <VBox class="sapUiSmallMarginBottom">
                                <HBox justifyContent="SpaceBetween">
                                    <Label text="QM"/>
                                    <Text text="{dashboardData>/module/QM}"/>
                                </HBox>
                                <ProgressIndicator percentValue="{dashboardData>/modulePercent/QM}" displayValue="{dashboardData>/modulePercent/QM}%" state="Information"/>
                            </VBox>
                        </layout:Grid>
                    </Panel>
                </HBox>

                <core:HTML content="&lt;hr style='border: none; border-top: 1px solid #e5e5e5; margin: 1.5rem 0;' /&gt;"/>

                <!-- ======================================================== -->
                <!-- 2b. QUALITY & SLA METRICS                                -->
                <!-- ======================================================== -->
                <Title text="{i18n>dashboardAdvancedKpiTitle}" level="H2" class="sapUiSmallMarginBottom"/>

                <HBox wrap="Wrap" class="sapUiTinyMarginBottom">
                    <!-- SLA Compliance % -->
                    <GenericTile header="{i18n>kpiSlaCompliance}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <TileContent unit="%">
                            <NumericContent
                                value="{dashboardData>/slaCompliance}"
                                valueColor="{= ${dashboardData>/slaCompliance} >= 80 ? 'Good' : (${dashboardData>/slaCompliance} >= 50 ? 'Critical' : 'Error') }"
                                icon="sap-icon://accept"/>
                        </TileContent>
                    </GenericTile>

                    <!-- MTTR -->
                    <GenericTile header="{i18n>kpiMttr}" subheader="{i18n>kpiMttrUnit}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <TileContent>
                            <NumericContent
                                value="{dashboardData>/mttrDays}"
                                valueColor="Neutral"
                                icon="sap-icon://lead-time"/>
                        </TileContent>
                    </GenericTile>

                    <!-- Reopen Rate % -->
                    <GenericTile header="{i18n>kpiReopenRate}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <TileContent unit="%">
                            <NumericContent
                                value="{dashboardData>/reopenRate}"
                                valueColor="{= ${dashboardData>/reopenRate} > 20 ? 'Error' : (${dashboardData>/reopenRate} > 0 ? 'Critical' : 'Good') }"
                                icon="sap-icon://history"/>
                        </TileContent>
                    </GenericTile>
                </HBox>

                <Text text="{i18n>dashboardKpiFallbackNote}" class="sapUiTinyMarginBottom sapMTextColorSecondary"/>

                <core:HTML content="&lt;hr style='border: none; border-top: 1px solid #e5e5e5; margin: 1.5rem 0;' /&gt;"/>

                <!-- ======================================================== -->
                <!-- 3. DEVELOPER WORKLOAD TABLE                              -->
                <!-- ======================================================== -->
                <Table
                    id="developerWorkloadTable"
                    items="{
                        path: '/Developer',
                        sorters: [{path: 'workload_score', descending: true}]
                    }"
                    sticky="ColumnHeaders"
                    class="sapUiResponsiveMargin">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{i18n>dashboardWorkloadTitle}" level="H2"/>
                            <ToolbarSpacer/>
                            <Text text="{i18n>dashboardWorkloadNote}" class="sapUiSubTemplates"/>
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column>
                            <Text text="{i18n>dashboardColDevId}"/>
                        </Column>
                        <Column hAlign="Center">
                            <Text text="{i18n>dashboardColModule}"/>
                        </Column>
                        <Column hAlign="Center" width="8rem">
                            <Text text="{i18n>dashboardColStatus}"/>
                        </Column>
                        <Column hAlign="Center" width="18rem">
                            <Text text="{i18n>dashboardColWorkload}"/>
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectIdentifier title="{developer_id}"/>
                                <ObjectStatus text="{modulename}" state="Information" inverted="true"/>
                                <ObjectStatus
                                    text="{= ${is_active} === 'X' ? 'Active' : 'Inactive'}"
                                    state="{= ${is_active} === 'X' ? 'Success' : 'Error'}"/>
                                <ProgressIndicator
                                    percentValue="{= ${workload_score} * 10 }"
                                    displayValue="{workload_score} / 10"
                                    state="{= ${workload_score} &gt; 6 ? 'Error' : (${workload_score} &gt; 3 ? 'Warning' : 'Success')}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </layout:VerticalLayout>
        </content>
    </Page>
</mvc:View>
