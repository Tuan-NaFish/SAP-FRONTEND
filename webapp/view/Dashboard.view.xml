<mvc:View
    controllerName="sap.defectmgmt.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:f="sap.f"
    xmlns:cssgrid="sap.ui.layout.cssgrid"
    xmlns:mc="sap.suite.ui.microchart">

    <Page
        id="dashboardPage"
        title="{i18n>dashboardPageTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>
            <!-- ======================================================== -->
            <!-- 1. KPI TILES CONTAINER                                   -->
            <!-- ======================================================== -->
            <layout:VerticalLayout width="100%" class="sapUiSmallMargin">

                <!-- Critical Defect Red Alert (shown when open critical count >= threshold) -->
                <!-- Critical Defect Red Alert (expression binding — no derivable state in model) -->
                <MessageStrip
                    text="{ parts: ['dashboardData>/totalCritical', 'dashboardData>/criticalThreshold'], formatter: '.formatCriticalAlertText' }"
                    type="Error"
                    showIcon="true"
                    visible="{= ${dashboardData>/totalCritical} >= ${dashboardData>/criticalThreshold} }"
                    class="sapUiSmallMarginBottom"/>

                <Title text="{i18n>dashboardKpiTitle}" level="H2" class="sapUiSmallMarginBottom"/>

                <HBox wrap="Wrap" class="sapUiTinyMarginBottom">
                    <!-- Total Defects KPI: includes every lifecycle status -->
                    <GenericTile header="{i18n>kpiTotalTickets}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom dashboardKpiNoAccent" press=".onKpiTilePress" valueColor="Neutral">
                        <customData>
                            <core:CustomData key="kpiType" value="totalTickets" />
                        </customData>
                        <TileContent>
                            <NumericContent value="{dashboardData>/totalTickets}" valueColor="Neutral" icon="sap-icon://quality-issue"/>
                        </TileContent>
                    </GenericTile>

                    <!-- Total Open KPI -->
                    <GenericTile header="{i18n>kpiTotalOpen}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom dashboardKpiNoAccent" press=".onKpiTilePress" valueColor="Critical">
                        <customData>
                            <core:CustomData key="kpiType" value="totalOpen" />
                        </customData>
                        <TileContent>
                            <NumericContent value="{dashboardData>/totalOpen}" valueColor="Critical" icon="sap-icon://active-folder"/>
                        </TileContent>
                    </GenericTile>

                    <!-- Overdue KPI -->
                    <GenericTile header="{i18n>kpiOverdue}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" press=".onKpiTilePress">
                        <customData>
                            <core:CustomData key="kpiType" value="overdue" />
                        </customData>
                        <TileContent>
                            <NumericContent value="{dashboardData>/totalOverdue}" valueColor="Error" icon="sap-icon://alert"/>
                        </TileContent>
                    </GenericTile>

                    <!-- Critical SLA KPI -->
                    <GenericTile header="{i18n>kpiCritical}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" press=".onKpiTilePress">
                        <customData>
                            <core:CustomData key="kpiType" value="critical" />
                        </customData>
                        <TileContent>
                            <NumericContent value="{dashboardData>/totalCritical}" valueColor="Error" icon="sap-icon://warning2"/>
                        </TileContent>
                    </GenericTile>

                    <!-- Resolved (Waiting Test) KPI -->
                    <GenericTile header="{i18n>kpiWaitingTesting}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" press=".onKpiTilePress">
                        <customData>
                            <core:CustomData key="kpiType" value="waitingTesting" />
                        </customData>
                        <TileContent>
                            <NumericContent value="{dashboardData>/totalTesting}" valueColor="Neutral" icon="sap-icon://user-settings"/>
                        </TileContent>
                    </GenericTile>

                    <!-- High Priority KPI -->
                    <GenericTile header="{i18n>kpiHighPriority}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom dashboardKpiNoAccent" press=".onKpiTilePress" valueColor="Critical">
                        <customData>
                            <core:CustomData key="kpiType" value="highPriority" />
                        </customData>
                        <TileContent>
                            <NumericContent value="{dashboardData>/totalHighPriority}" valueColor="Critical" icon="sap-icon://flag"/>
                        </TileContent>
                    </GenericTile>

                    <!-- Closed KPI -->
                    <GenericTile header="{i18n>kpiClosed}" frameType="OneByOne" class="sapUiTinyMarginBottom" press=".onKpiTilePress">
                        <customData>
                            <core:CustomData key="kpiType" value="closed" />
                        </customData>
                        <TileContent>
                            <NumericContent value="{dashboardData>/totalClosed}" valueColor="Good" icon="sap-icon://accept"/>
                        </TileContent>
                    </GenericTile>
                </HBox>

                <core:HTML content="&lt;hr style='border: none; border-top: 1px solid #e5e5e5; margin: 1.5rem 0;' /&gt;"/>

                <!-- ======================================================== -->
                <!-- 2. DEFECT DISTRIBUTION                                  -->
                <!-- ======================================================== -->
                <Title text="{i18n>dashboardDistributionTitle}" level="H2" class="sapUiSmallMarginBottom"/>
                <layout:Grid defaultSpan="XL6 L6 M12 S12" class="dashboardChartsGrid">
                    <Panel headerText="{i18n>dashboardStatusDistribution}" class="dashboardChartPanel dashboardStatusPanel sapUiNoContentPadding">
                        <Text text="{dashboardData>/chartTotalLabel}" class="dashboardChartTotal"/>
                        <core:HTML id="statusDonut" class="dashboardCustomChart"/>
                    </Panel>
                    <Panel headerText="Module x Severity" class="dashboardChartPanel dashboardColumnPanel sapUiNoContentPadding">
                        <core:HTML id="severityColumns" class="dashboardCustomChart"/>
                    </Panel>
                </layout:Grid>
                <MessageStrip text="{dashboardData>/distributionInsight}" type="Information" showIcon="true" class="dashboardInsight sapUiSmallMarginTop"/>

                <core:HTML content="&lt;hr style='border: none; border-top: 1px solid #e5e5e5; margin: 1.5rem 0;' /&gt;"/>

                <!-- ======================================================== -->
                <!-- 2b. QUALITY & SLA METRICS                                -->
                <!-- ======================================================== -->
                <Title text="{i18n>dashboardAdvancedKpiTitle}" level="H2" class="sapUiSmallMarginBottom"/>

                <HBox wrap="Wrap" class="sapUiTinyMarginBottom">
                    <!-- SLA Compliance % -->
                    <GenericTile header="{i18n>kpiSlaCompliance}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom nonInteractiveTile">
                        <TileContent unit="%">
                            <NumericContent
                                value="{dashboardData>/slaCompliance}"
                                valueColor="{= ${dashboardData>/slaCompliance} >= 80 ? 'Good' : (${dashboardData>/slaCompliance} >= 50 ? 'Critical' : 'Error') }"
                                icon="sap-icon://accept"/>
                        </TileContent>
                    </GenericTile>

                    <!-- MTTR -->
                    <GenericTile header="{i18n>kpiMttr}" subheader="{i18n>kpiMttrUnit}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom nonInteractiveTile">
                        <TileContent>
                            <NumericContent
                                value="{dashboardData>/mttrDays}"
                                valueColor="Neutral"
                                icon="sap-icon://lead-time"/>
                        </TileContent>
                    </GenericTile>

                    <!-- Reopen Rate % -->
                    <GenericTile header="{i18n>kpiReopenRate}" frameType="OneByOne" class="sapUiTinyMarginEnd sapUiTinyMarginBottom nonInteractiveTile">
                        <TileContent unit="%">
                            <NumericContent
                                value="{dashboardData>/reopenRate}"
                                valueColor="{= ${dashboardData>/reopenRate} > 20 ? 'Error' : (${dashboardData>/reopenRate} > 0 ? 'Critical' : 'Good') }"
                                icon="sap-icon://history"/>
                        </TileContent>
                    </GenericTile>
                </HBox>

                <Text text="{i18n>dashboardKpiFallbackNote}" class="sapUiTinyMarginBottom sapMTextColorSecondary"/>

                <core:HTML content="&lt;hr style='border: none; border-top: 1px solid #e5e5e5; margin: 1.5rem 0;' /&gt;"/>

                <!-- ======================================================== -->
                <!-- 3. DEVELOPER WORKLOAD TABLE                              -->
                <!-- ======================================================== -->
                <Table
                    id="developerWorkloadTable"
                    items="{
                        path: '/Developer',
                        sorters: [{path: 'workload_score', descending: true}]
                    }"
                    sticky="ColumnHeaders"
                    growing="true"
                    growingScrollToLoad="true"
                    noDataText="{i18n>dashboardWorkloadNoData}"
                    width="100%"
                    class="dashboardWorkloadTable">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{i18n>dashboardWorkloadTitle}" level="H2"/>
                            <ToolbarSpacer/>
                            <Label text="{i18n>dashboardWorkloadNote}" displayOnly="true" class="sapUiSubTemplates sapUiSmallMarginEnd" width="auto"/>
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column width="14rem" demandPopin="true" minScreenWidth="Tablet">
                            <Text text="{i18n>dashboardColDevId}"/>
                        </Column>
                        <Column hAlign="Center" width="9rem" demandPopin="true" minScreenWidth="Tablet">
                            <Text text="{i18n>dashboardColModule}"/>
                        </Column>
                        <Column hAlign="Center" width="9rem" demandPopin="true" minScreenWidth="Tablet">
                            <Text text="{i18n>dashboardColStatus}"/>
                        </Column>
                        <Column hAlign="Center" demandPopin="true" minScreenWidth="Tablet">
                            <Text text="{i18n>dashboardColWorkload}"/>
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectIdentifier title="{developer_id}"/>
                                <ObjectStatus text="{modulename}" state="Information" inverted="true"/>
                                <ObjectStatus
                                    text="{= ${is_active} === 'X' ? 'Active' : 'Inactive'}"
                                    state="{= ${is_active} === 'X' ? 'Success' : 'Error'}"/>
                                <HBox
                                    alignItems="Center"
                                    justifyContent="Center"
                                    class="workloadCell">
                                    <ObjectNumber
                                        number="{workload_score}"
                                        unit="/ 10"
                                        state="{= ${workload_score} &gt; 6 ? 'Error' : (${workload_score} &gt; 3 ? 'Warning' : 'Success')}"
                                        class="workloadScore"/>
                                    <ProgressIndicator
                                        percentValue="{= Math.max(0, Math.min(100, Number(${workload_score}) * 10)) }"
                                        showValue="false"
                                        width="12rem"
                                        state="{= ${workload_score} &gt; 6 ? 'Error' : (${workload_score} &gt; 3 ? 'Warning' : 'Success')}"
                                        class="workloadBar"/>
                                    <ObjectStatus
                                        text="{= ${workload_score} &gt; 6 ? 'High' : (${workload_score} &gt; 3 ? 'Medium' : 'Low')}"
                                        state="{= ${workload_score} &gt; 6 ? 'Error' : (${workload_score} &gt; 3 ? 'Warning' : 'Success')}"
                                        class="workloadLevel"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </layout:VerticalLayout>
        </content>
    </Page>
</mvc:View>
