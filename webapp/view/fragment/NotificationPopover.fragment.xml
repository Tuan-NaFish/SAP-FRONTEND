<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <Popover title="Notifications" placement="Bottom" contentWidth="350px">
        <content>
            <List showSeparators="All">
                
                <NotificationListItem
                    title="Critical Defect Logged!"
                    description="DEF-1001 requires immediate attention."
                    showCloseButton="true"
                    datetime="Just now"
                    priority="High" />
                    
                <NotificationListItem
                    title="SLA Warning"
                    description="Ticket DEF-1003 is approaching the deadline."
                    showCloseButton="true"
                    datetime="2 hours ago"
                    priority="Medium" />
                    
            </List>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button text="Mark all as read" type="Transparent" />
            </Toolbar>
        </footer>
    </Popover>

</core:FragmentDefinition>