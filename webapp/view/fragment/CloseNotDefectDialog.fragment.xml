<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="closeNotDefectDialog" title="Close as Not a Defect">
        <content>
            <TextArea id="txtNotDefectReason" width="100%" rows="5" placeholder="Enter reason"/>
        </content>
        <beginButton>
            <Button text="Close Ticket" type="Reject" press=".onCloseAsNotDefectSubmit"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCloseAsNotDefectCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
