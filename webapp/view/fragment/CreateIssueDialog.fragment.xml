<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:upload="sap.m.upload">
    <Dialog title="Create New Defect Ticket" contentWidth="650px" class="sapUiContentPadding">
        <content>
            <form:SimpleForm layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1">
                <form:content>
                    <Label text="Title" required="true"/>
                    <Input id="inputTitle" placeholder="Enter brief issue title..." />

                    <Label text="Module" required="true"/>
                    <Select id="selectModule">
                        <core:Item key="FI" text="FI - Financial Accounting" />
                        <core:Item key="MM" text="MM - Material Management" />
                        <core:Item key="SD" text="SD - Sales &amp; Distribution" />
                    </Select>

                    <!-- ĐÃ THÊM: Dropdown chọn Developer lấy từ OData -->
                    <Label text="Assign Developer"/>
                    <Select id="selectDeveloper" items="{path: 'defectModel>/Developer'}" forceSelection="false">
                        <core:Item key="{defectModel>developer_id}" text="{defectModel>developer_id} - Workload: {defectModel>workload_score}" />
                    </Select>

                    <Label text="Severity" required="true"/>
                    <Select id="selectSeverity">
                        <core:Item key="Low" text="Low" />
                        <core:Item key="Medium" text="Medium" />
                        <core:Item key="High" text="High" />
                        <core:Item key="Critical" text="Critical" />
                    </Select>

                    <!-- ĐÃ THÊM: Due Date và Affected Version -->
                    <Label text="Due Date" required="true"/>
                    <DatePicker id="inputDueDate" valueFormat="yyyy-MM-dd" displayFormat="yyyy-MM-dd" placeholder="Select due date..." />

                    <Label text="Affected Version"/>
                    <Input id="inputVersion" value="1.0" editable="false" />

                    <Label text="Steps to Reproduce / Description" required="true"/>
                    <TextArea id="inputDesc" rows="4" placeholder="1. Open T-Code...&#10;2. Enter data...&#10;3. System dumps..." />
                </form:content>
            </form:SimpleForm>

            <VBox class="sapUiSmallMarginTop">
                <Title text="Attachments" level="H5" class="sapUiTinyMarginBottom" />
                <upload:UploadSet
                    id="uploadSet"
                    instantUpload="false"
                    showIcons="true"
                    uploadEnabled="true"
                    multiple="true" 
                    maxFileSize="5"
                    fileTypes="jpg,png,pdf,docx"
                    fileTypeMismatch=".onTypeMissmatch"
                    fileSizeExceeded=".onFileSizeExceed"
                    noDataText="Kéo &amp; Thả tập tin đính kèm vào đây"
                    noDataDescription="Hoặc sử dụng nút Tải lên ở góc phải (Tối đa 5MB)">
                </upload:UploadSet>
            </VBox>
        </content>
        <buttons>
            <Button text="Save" type="Emphasized" press=".onSaveIssue" />
            <Button text="Cancel" press=".onCancelIssue" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>