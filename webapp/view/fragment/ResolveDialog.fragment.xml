<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog
        id="resolveDialog"
        title="{i18n>dialogResolveTitle}">
        <content>
            <form:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12">
                <form:content>
                    <!-- Root Cause (Mandatory) -->
                    <Label text="{i18n>dialogRootCause}" required="true"/>
                    <TextArea
                        id="txtRootCause"
                        rows="4"
                        width="100%"
                        placeholder="Enter the root cause of the defect..."/>

                    <!-- Fix Description (Mandatory) -->
                    <Label text="{i18n>dialogFixDescription}" required="true"/>
                    <TextArea
                        id="txtFixDescription"
                        rows="4"
                        width="100%"
                        placeholder="Describe the code changes or how the bug was resolved..."/>

                    <!-- Resolution Note (Optional) -->
                    <Label text="{i18n>dialogResolutionNote}"/>
                    <TextArea
                        id="txtResolutionNote"
                        rows="3"
                        width="100%"
                        placeholder="Enter any additional notes (optional)..."/>
                </form:content>
            </form:SimpleForm>
        </content>
        <beginButton>
            <Button
                text="{i18n>dialogSubmit}"
                type="Emphasized"
                press=".onResolveSubmit"/>
        </beginButton>
        <endButton>
            <Button
                text="{i18n>dialogCancel}"
                press=".onResolveCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
