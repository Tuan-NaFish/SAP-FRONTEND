<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog
        id="reassignDialog"
        title="{i18n>dialogReassignTitle}">
        <content>
            <form:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12">
                <form:content>
                    <!-- Assignment Role Selection -->
                    <Label text="Assignment Role" required="true"/>
                    <Select id="selAssignmentRole" selectedKey="PRIMARY" width="100%" change=".onAssignmentRoleChange">
                        <core:Item key="PRIMARY" text="PRIMARY (Lead / Main Developer)"/>
                        <core:Item key="CONTRIBUTOR" text="CONTRIBUTOR (Supporting Developer)"/>
                    </Select>

                    <!-- Developer Select -->
                    <Label text="{i18n>dialogDeveloperLabel}" required="true"/>
                    <Select
                        id="selDeveloper"
                        width="100%">
                    </Select>

                </form:content>
            </form:SimpleForm>
        </content>
        <beginButton>
            <Button
                text="{i18n>dialogSubmit}"
                type="Emphasized"
                press=".onReassignSubmit"/>
        </beginButton>
        <endButton>
            <Button
                text="{i18n>dialogCancel}"
                press=".onReassignCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
