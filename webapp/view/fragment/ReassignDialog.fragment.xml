<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog
        id="reassignDialog"
        title="{i18n>dialogReassignTitle}">
        <content>
            <form:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12">
                <form:content>
                    <!-- Developer Select -->
                    <Label text="{i18n>dialogDeveloperLabel}" required="true"/>
                    <Select
                        id="selDeveloper"
                        width="100%"
                        items="{path: '/Developer', sorters: [{path: 'workload_score', descending: false}]}">
                        <core:Item key="{developer_id}" text="{developer_id} (Workload: {workload_score})"/>
                    </Select>
                </form:content>
            </form:SimpleForm>
        </content>
        <beginButton>
            <Button
                text="{i18n>dialogSubmit}"
                type="Emphasized"
                press=".onReassignSubmit"/>
        </beginButton>
        <endButton>
            <Button
                text="{i18n>dialogCancel}"
                press=".onReassignCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
