{
     "compilerOptions": {
       "target": "ES2020",
       "module": "ES2020",
       "moduleResolution": "node",
       "allowJs": true,
       "checkJs": false,
       "strict": false,
       "esModuleInterop": true,
       "skipLibCheck": true,
       "isolatedModules": true,
       "noEmit": true,
       "lib": ["ES2020", "DOM"],
       "baseUrl": ".",
       "paths": {
         "sap/defectmgmt/*": ["webapp/*"]
       },
       "types": ["@openui5/types", "@sapui5/ts-types-esm"]
     },
     "include": [
       "webapp/**/*"
     ]
   }