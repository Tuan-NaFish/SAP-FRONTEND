managed implementation in class zbp_i_issue unique;
strict ( 2 );

define behavior for Z_I_ISSUE alias Issue
persistent table zissue
lock master
authorization master ( instance )
{
  create;
  update;
  delete;

  determination setAuditFields on modify { create; }

  static action createIssue parameter Z_A_CREATE_ISSUE result [1] $self;

  action assignIssue parameter Z_A_ASSIGN_ISSUE result [1] $self;
  action startProgress result [1] $self;
  action resolveIssue parameter Z_A_RESOLVE_ISSUE result [1] $self;
  action startTesting result [1] $self;
  action closeIssue result [1] $self;
  action reopenIssue result [1] $self;

  association _History;
  association _Comment;
  association _Attachment;
}

define behavior for Z_I_ATTACHMENT
persistent table zattachments
lock dependent by _Issue
authorization dependent by _Issue
{
  update;
  delete;
  field ( readonly ) issue_id;
  association _Issue;
}

define behavior for Z_I_COMMENT
persistent table zcomment
lock dependent by _Issue
authorization dependent by _Issue
{
  update;
  delete;
  field ( readonly ) issue_id;
  association _Issue;
}

define behavior for Z_I_ISSUE_HISTORY
persistent table zissue_history
lock dependent by _Issue
authorization dependent by _Issue
{
  update;
  delete;
  field ( readonly ) issue_id;
  association _Issue;
}
